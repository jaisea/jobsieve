# Copy this file to `.env` and fill in what you have.
# Every key is optional — each source or provider skips itself with a warning
# when its key is missing, so a half-filled file still runs end to end.

# ─────────────────────────────────────────────────────────────────────────────
# AI ADJUDICATION  (optional — decides the ~2% of postings the rules can't)
# ─────────────────────────────────────────────────────────────────────────────
# Gemini is the only provider. There used to be three — Ollama, Gemini and
# Anthropic, tried in priority order — but the chain was never used, so the
# other two were removed. Leave LLM_PROVIDERS unset unless you have a reason.
LLM_PROVIDERS=gemini

# Park the provider without deleting the key. With it off (or with no key at
# all) search still runs: it falls back to rules verdicts and says so.
GEMINI_ENABLED=true

# --- Gemini. Judging and writing are configured apart, because billing belongs to
# the Google project a key was made in: judge on a key from a FREE project (no
# billing account linked), write on a key from a billed one for the better model.
# Keys: https://aistudio.google.com/apikey
GEMINI_API_KEY_JUDGE=
GEMINI_MODEL_JUDGE=gemini-flash-lite-latest
# Leave at 1 on the free tier (about ten requests a minute); more only makes 429s.
GEMINI_MAX_CONCURRENCY_JUDGE=1

# Optional. Writing a CV and letter is 2-3 calls per application. Unset means it
# uses the judging key and model.
#GEMINI_API_KEY_APPLY=
#GEMINI_MODEL_APPLY=gemini-3.7-flash
# Not read by anything yet: writing makes its calls one after another.
#GEMINI_MAX_CONCURRENCY_APPLY=4

# OFF by default, because it spends money. When the FREE judging project's daily quota is
# spent, carry on with the billed _APPLY project instead of waiting for the reset (09:00 in
# Germany). Needs GEMINI_API_KEY_APPLY. Only a spent DAILY quota switches it — a per-minute
# limit clears in seconds. It asks the cheap judging model (about $0.0003 a call), not the
# writing model, and every run that does it says how many calls were paid for.
#GEMINI_JUDGE_OVERFLOW_TO_APPLY=true

# ─────────────────────────────────────────────────────────────────────────────
# JOB-ALERT EMAILS  (the only route to LinkedIn / StepStone / XING)
# ─────────────────────────────────────────────────────────────────────────────
# Create a saved search + daily alert on each site, route those emails into one
# folder, and point IMAP_FOLDER at it. Reading your own inbox is legitimate;
# scraping those sites is not, and StepStone/XING have no other route at all.
#
# Use an APP PASSWORD, never your normal login password:
#   Gmail    myaccount.google.com/apppasswords   (host imap.gmail.com)
#   Outlook  account.microsoft.com/security      (host outlook.office365.com)
#   GMX      Settings > POP3/IMAP                (host imap.gmx.net)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Folder holding the alerts. Gmail labels are folders: "jobalerts" or "INBOX/jobalerts"
IMAP_FOLDER=INBOX
# How far back to read the FIRST time, and after the parser, the rules or your profile change.
# Every other scan downloads only mail that arrived since the last one (a UID bookmark in
# data/mail-state.json), so this is a window, not a cost per scan. 7 is right for daily alerts.
IMAP_SINCE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# JOB SOURCES
# ─────────────────────────────────────────────────────────────────────────────

# Adzuna — free developer key: https://developer.adzuna.com/
# ~250 calls/day. The best route to German listings incl. StepStone and XING.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# ~200 requests/month. Also surfaces Arbeitsagentur listings indirectly.
# Endpoint is /search-v2 (configured in config/sources.json).
RAPIDAPI_KEY=
